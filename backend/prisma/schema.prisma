generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder — o Prisma não gera client com o schema sem nenhum model
// definido (quebra o build). Apague este model assim que criar os models
// reais do projeto (ex.: Processo, Contrato, OrdemCompra, InteracaoContabil)
// e rode `npm run db:migrate` pra gerar a primeira migration de verdade.
model Placeholder {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("placeholder")
}
